# Multi-Agent Monitoring API Key
MONITORING_API_KEY=your_monitoring_secret_key
MONITORING_JWT_SECRET=auto-generated-or-set-your-jwt-secret

# Model Provider API Key (NVIDIA NIM AI Endpoints hosting Nemotron & DeepSeek models)
NVIDIA_API_KEY=nvapi-REPLACE_ME

# Telemetry and Database
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gcp-multi-agent-team
MONITORING_DATABASE_URL=postgresql://agent:change-me@localhost:5432/agent_memory
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agent_memory
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me
APP_ENV=local
LOG_LEVEL=INFO

# Security & Governance Policies
ALLOW_GCP_MUTATIONS=false
ALLOW_TERRAFORM_APPLY=false
ALLOW_PRODUCTION_DEPLOYMENT=false
